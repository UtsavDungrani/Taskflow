# --- Database -------------------------------------------------------------
# Any Postgres. Pick the region NEAREST YOU -- it cannot be changed later and
# dominates how fast the app feels (see README > Performance).
#
# Supabase: use the *Session pooler* string, port 5432. Direct connection is
# IPv6-only on the free plan; the 6543 transaction pooler breaks Prisma's
# prepared statements.
#   postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Neon: the *pooled* connection string.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Percent-encode special characters in the password (@ becomes %40), and do
# not keep the square brackets around [YOUR-PASSWORD].
DATABASE_URL=""

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional. When both are set, "Sign in with GitHub" appears on the login page.
# Create at https://github.com/settings/developers -> New OAuth App
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Dev-only escape hatch: lets you sign in as the seeded user with no OAuth app.
# MUST be left unset/false in production.
ALLOW_DEV_LOGIN="true"
DEV_LOGIN_EMAIL="you@example.com"
