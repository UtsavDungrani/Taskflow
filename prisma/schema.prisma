// TaskFlow schema.
//
// Design notes (read before changing):
//   * Every row hangs off a Workspace, even though there is one user today.
//     That is the tenancy seam: adding teammates later is an INSERT into
//     WorkspaceMember, not a migration of every table.
//   * Kanban columns are data (TaskStatus), not an enum. Each status carries a
//     `category` so "is this task done?" stays queryable no matter what the
//     user renames their columns to.
//   * Task.position is a Float so reordering only rewrites the moved row:
//     new position = midpoint of its two neighbours.
//   * The gitHub* fields are nullable and unused in phase 1. They exist so the
//     integration is a feature, not a schema rewrite.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth prisma adapter contract)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  members    WorkspaceMember[]
  created    Task[]            @relation("TaskCreator")
  assigned   Task[]            @relation("TaskAssignee")
  comments    Comment[]
  activities  Activity[]
  timeEntries TimeEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  projects Project[]
  labels   Label[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects and their board columns
// ---------------------------------------------------------------------------

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  // Short prefix used to build human ticket refs, e.g. "TF" -> TF-14.
  key         String
  description String?
  color       String    @default("#b4471f")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Monotonic per-project ticket counter. Bumped inside the create-task
  // transaction so numbers are never reused, even after a delete.
  taskCounter Int @default(0)

  // Phase 3: GitHub repo binding.
  gitHubRepoOwner String?
  gitHubRepoName  String?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statuses  TaskStatus[]
  tasks     Task[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

// Semantic bucket for a column. Lets "show me what's still open" work even
// when a user renames "In Progress" to "Cooking".
enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

model TaskStatus {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  StatusCategory @default(TODO)
  color     String         @default("#a1907c")
  position  Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id        String @id @default(cuid())
  projectId String
  // Per-project ticket number. Renders as "<project.key>-<number>".
  number    Int
  statusId  String

  title       String
  description String? @db.Text
  priority    Priority @default(NONE)

  // Ordering within a status column. Midpoint insertion; see header note.
  position Float

  creatorId  String?
  assigneeId String?

  // startDate + dueDate are what the Gantt and timeline views render.
  // dueDate alone is what the "you are about to miss this" view reads.
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  // Time is kept in whole minutes rather than fractional hours: summing
  // floats for durations drifts, and "1h 30m" is exactly 90.
  estimateMinutes Int?
  // Denormalised sum of this task's TimeEntry rows, maintained in the same
  // transaction as the entries. Without it, showing spent time on a board of
  // 50 cards would mean 50 aggregate queries.
  spentMinutes    Int  @default(0)

  // Subtasks: a task may nest under a parent in the same project.
  parentId String?

  // Phase 3: GitHub issue/PR binding.
  gitHubIssueNumber Int?
  gitHubIssueUrl    String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status   TaskStatus @relation(fields: [statusId], references: [id])
  creator  User?      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignee User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent   Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)

  subtasks    Task[]      @relation("Subtasks")
  labels      TaskLabel[]
  comments    Comment[]
  activities  Activity[]
  timeEntries TimeEntry[]
  // Gantt edges, both directions.
  blockedBy  TaskDependency[]  @relation("DependencyBlocked")
  blocks     TaskDependency[]  @relation("DependencyBlocker")

  @@unique([projectId, number])
  @@index([projectId, statusId, position])
  // The index behind the "what's overdue / due soon" dashboard.
  @@index([assigneeId, dueDate])
  @@index([parentId])
}

// Gantt dependency edge: `blockerId` must finish before `blockedId` starts.
model TaskDependency {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Task @relation("DependencyBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Task @relation("DependencyBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ---------------------------------------------------------------------------
// Time tracking
// ---------------------------------------------------------------------------

// One logged stretch of work. Kept as rows rather than a single total on the
// task so the history survives: which day the work happened, who did it, and
// what it was. That is what makes "hours logged this week" possible later
// without a backfill.
model TimeEntry {
  id      String  @id @default(cuid())
  taskId  String
  userId  String?
  minutes Int
  note    String?
  // Day granularity, stored as a DATE so it cannot drift across timezones.
  spentOn DateTime @db.Date

  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, spentOn])
  @@index([userId, spentOn])
}

// ---------------------------------------------------------------------------
// Labels, comments, activity
// ---------------------------------------------------------------------------

model Label {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#8a8578")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

// Append-only audit trail. Powers per-task history and, later, a activity feed.
model Activity {
  id     String @id @default(cuid())
  taskId String
  actorId String?
  // e.g. "status.changed", "task.created", "due_date.changed"
  type   String
  // Free-form payload: { from, to } etc. Kept as JSON so new event types
  // don't need a migration.
  data   Json?

  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}
